      "seed": 1060215430,
      "version": 39,
      "versionNonce": 929881754,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791090969881,
      "created": 1791090865009,
      "link": null,
      "locked": false,
      "text": "// Manual slot generation  use library luxon\n\nlet date  = new  Date();\n\ndate.setUTCHours(0, 0, 0, 0);\n\nconst currentMonth =  date.getMonth()+1;\n\nlet bufferBefore = 10;\n\nlet bufferAfter  = 10;\n\nlet durationInMinutes = 30;\n\nwhile(date.getMonth()+1  == currentMonth){\n\nconst loopISO = date.toISOString();\n\nconst slotDate  = loopISO.slice(0,10);\n\nlet startTime = date.toISOString().slice(11, 19)\n\nlet endTime  = date.toISOString().slice(11, 19)\n\nlet slotObject = {\n\neventId    : 'event id name',\n\ncurrenDate : slotDate,\n\nstartTime :  startTime ,\n\nstatus:\"available\",\n\nendTime : endTime\n\n}\n\nconsole.log(slotObject);\n\n}",
      "fontSize": 16,
      "baseFontSize": 20,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "n-riIzBdU4oULsZPuL9oa",
      "originalText": "// Manual slot generation  use library luxon\n\nlet date  = new  Date();\n\ndate.setUTCHours(0, 0, 0, 0);\n\nconst currentMonth =  date.getMonth()+1;\n\nlet bufferBefore = 10;\n\nlet bufferAfter  = 10;\n\nlet durationInMinutes = 30;\n\nwhile(date.getMonth()+1  == currentMonth){\n\nconst loopISO = date.toISOString();\n\nconst slotDate  = loopISO.slice(0,10);\n\nlet startTime = date.toISOString().slice(11, 19)\n\nlet endTime  = date.toISOString().slice(11, 19)\n\nlet slotObject = {\n\neventId    : 'event id name',\n\ncurrenDate : slotDate,\n\nstartTime :  startTime ,\n\nstatus:\"available\",\n\nendTime : endTime\n\n}\n\nconsole.log(slotObject);\n\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
