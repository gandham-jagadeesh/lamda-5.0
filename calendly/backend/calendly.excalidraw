      "link": null,
      "locked": false,
      "text": "A workflow engine is a software system that manages, executes, and tracks multi-step\nprocesses while automatically handling state, timing, and failure recovery.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A workflow engine is a software system that manages, executes, and tracks multi-step processes while automatically handling state, timing, and failure recovery.",
