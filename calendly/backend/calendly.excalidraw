    {
      "id": "l-RfQY6-abhahScnjgyIA",
      "type": "text",
      "x": 14997.561122793246,
      "y": 4704.7354743984115,
      "width": 422.3994140625,
      "height": 820,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
