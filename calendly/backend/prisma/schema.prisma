generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id                    Int                     @id @default(autoincrement())
  first_name            String?
  last_name             String?
  email                 String                  @unique
  password              String
  slug                  String?
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  events                eventType[]
  availabilityRule      availabilityRule[]
  availabilityException availabilityException[]
  slot                  slot[]
  booking               booking[]
}

model eventType {
  id                  Int       @id @default(autoincrement())
  title               String
  description         String?
  locationType        String    @default("online")
  locationValue       String?
  slug                String
  host_id             Int
  durationMinutes     Int
  bufferBeforeMinutes Int       @default(0)
  bufferAfterMinutes  Int       @default(0)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                user      @relation(fields: [host_id], references: [id], onDelete: Cascade)
  slot                slot[]
  boooking            booking[]

  @@unique([host_id, slug])
  @@map("event_types")
}

model availabilityRule {
  id        Int      @id @default(autoincrement())
  user_id   Int
  weekday   String
  isActive  Boolean  @default(true)
  timezone  String   @default("UTC")
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, weekday])
  @@map("availability_rules")
}

model availabilityException {
  id        Int      @id @default(autoincrement())
  user_id   Int
  date      DateTime @db.Date
  type      String
  startTime String?
  endTime   String?
  timezone  String   @default("UTC")
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, date])
  @@map("availability_exceptions")
}

model slot {
  id           String   @id @default(cuid()) // why we used cuid :
  host_id      Int
  eventType_id Int
  startAt      DateTime
  endAt        DateTime
  status       String   @default("AVAILABLE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  host      user      @relation(fields: [host_id], references: [id], onDelete: Cascade)
  eventType eventType @relation(fields: [eventType_id], references: [id], onDelete: Cascade)
  booking   booking[]

  @@unique([eventType_id, startAt, endAt]) //don't want user to have an same event with same timings
  @@index([host_id, startAt])
  @@index([eventType_id, startAt, status])
  @@map("slots")
}

model booking {
  id               Int       @id @default(autoincrement())
  slot_id          String
  eventType_id     Int
  host_id          Int
  status           String    @default("PENDING")
  inviteeEmail     String
  inviteeNotes     String?
  inviteeName      String
  meetLink         String?
  calenderEvent_id String?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  host      user      @relation(fields: [host_id], references: [id], onDelete: Cascade)
  eventType eventType @relation(fields: [eventType_id], references: [id], onDelete: Cascade)
  slot      slot      @relation(fields: [slot_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index(inviteeEmail)
  @@index([host_id, createdAt])
  @@map("bookings")
}
